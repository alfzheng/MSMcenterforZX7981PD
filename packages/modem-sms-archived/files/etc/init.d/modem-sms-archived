#!/bin/sh /etc/rc.common

USE_PROCD=1
START=94
STOP=11

start_service() {
	local enabled archive_enabled archive_path
	config_load modem-sms-archive
	config_get_bool enabled main enabled 1
	config_get_bool archive_enabled main archive_enabled 0
	config_get archive_path main archive_path '/root/modem-sms/archive.sqlite3'
	[ "$enabled" -eq 1 ] || return 0
	umask 077

	# Do not create the archive directory while the feature is disabled.
	if [ "$archive_enabled" -eq 1 ]; then
		[ "$archive_path" = '/root/modem-sms/archive.sqlite3' ] || return 1
		install -d -m 700 /root/modem-sms || return 1
		if [ -e "$archive_path" ]; then
			chmod 600 "$archive_path" || return 1
		else
			install -m 600 /dev/null "$archive_path" || return 1
		fi
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/modem-sms-archived
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger modem-sms-archive
}

reload_service() {
	stop
	start
}
