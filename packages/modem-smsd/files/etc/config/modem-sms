config service 'main'
	option enabled '1'
	option backend 'lteat'
	# SM/ME are read serially on the target modem; keep the successful snapshot
	# long enough that opening LuCI does not start another cold modem scan.
	option cache_seconds '300'
	option list_limit_max '200'
	option request_history_max '500'
	option minimum_free_slots '4'
	option concat_window_seconds '600'
	option send_queue_max '20'
	option send_rate_limit_seconds '1'
	option request_state_path '/etc/modem-sms-idempotency.json'

config backend 'lteat'
	option object 'lteat'
	option switch_method 'send'
	option switch_argument 'cmd'
	option list_method 'get_sms'
	option send_method 'send_sms'
	option delete_method 'del_sms'
	option default_storage 'SM'
	option storage_order 'SM ME'
	# A cold dual-storage read has been measured at up to 44 seconds on ZX7981PD.
	option read_call_timeout_seconds '60'
	# Quectel get_sms may return a changing partial SM snapshot; merge up to ten reads.
	option read_retry_max '10'
	option send_call_timeout_seconds '120'
